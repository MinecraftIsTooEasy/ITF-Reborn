{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "depends": {
    "fishmodloader": ">=3.4.1",
    "many-lib": ">=2.3.0",
    "rusted_iron_core": ">=1.5.7",
    "conditional-mixin": "*"
  },
  "breaks": {
    "baubles": "<1.1.1"
  },
  "environment": "*",
  "description": "本模组是MITE-ITF移植到最新FML版本的分支, 移植基于FML1.4.0的ITF-R14.\n本模组需要ManyLib和RustedIronCore模组作为前置!",
  "icon": "assets/icon.png",
  "authors": [
    "Huix",
    "Rizur",
    "Debris",
    "Xy_Luce"
  ],
  "contact": {
    "homepage": "https://github.com/MinecraftIsTooEasy/ITF-Reborn",
    "issues": "https://github.com/MinecraftIsTooEasy/ITF-Reborn/issues",
    "sources": "https://github.com/MinecraftIsTooEasy/ITF-Reborn",
    "qqGroup": "661223990"
  },
  "entrypoints": {
    "preLaunch": [
      "net.oilcake.mitelros.EarlyRiser"
    ],
    "main": [
      "net.oilcake.mitelros.ITFStart"
    ],
    "emi": [
      "net.oilcake.mitelros.compat.emi.EmiPluginITF"
    ],
    "modmenu": [
      "net.oilcake.mitelros.compat.ModMenuImpl"
    ],
    "mite_ite": [
      "net.oilcake.mitelros.compat.ITEPluginImpl"
    ],
    "baubles": [
      "net.oilcake.mitelros.compat.BaublesPluginImpl"
    ],
    "newshop": [
      "net.oilcake.mitelros.compat.NewShopPluginImpl"
    ],
    "shop": [
      "net.oilcake.mitelros.compat.ShopPluginImpl"
    ],
    "waila": [
      "net.oilcake.mitelros.compat.waila.WailaPlugin"
    ]
  },
  "mixins": [
    "MITEIsTooFalse.mixins.json"
  ],
  "accessWidener": "MITEIsTooFalse.accesswidener",
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/EntityPlayer": [
        "net/oilcake/mitelros/mixin/interfaces/ITFEntityPlayer"
      ],
      "net/minecraft/Enchantment": [
        "net/oilcake/mitelros/mixin/interfaces/ITFEnchantment"
      ]
    }
  }
}
